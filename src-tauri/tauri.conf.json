{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "OBML Viewer",
  "version": "1.0.0",
  "identifier": "com.obmlviewer.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "OBML Viewer",
        "width": 1100,
        "height": 800,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "Yohan Tabrez",
    "copyright": "Copyright © Yohan Tabrez",
    "shortDescription": "Opera Mini OBML saved page viewer",
    "longDescription": "OBML Viewer by Yohan Tabrez — open and export Opera Mini saved pages (OBML 6, 12, 13, 15, 16).",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
